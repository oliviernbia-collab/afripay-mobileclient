# Requis pour un build de production (EAS Build / `expo build`) — laissez absent en développement
# (Expo Go / dev client), où l'app utilise l'IP locale définie dans src/config/api.js.
# Doit être une URL https:// : le démarrage échoue volontairement sinon (voir src/config/api.js).
EXPO_PUBLIC_API_URL=https://api.afripay.example
